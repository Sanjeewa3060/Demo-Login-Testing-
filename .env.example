# auto: use Asgardeo when the client id and base URL are set, otherwise mock mode.
# true: always use the local dummy sign-in.
# false: require Asgardeo. The API will not fall back to mock sign-in.
MOCK_MODE=auto

# Public client id from the Asgardeo application.
ASGARDEO_CLIENT_ID=

# Leave empty for a public PKCE client. If the Asgardeo app is confidential,
# put the secret here. The React app never receives this value.
ASGARDEO_CLIENT_SECRET=

# Organization handle from the Asgardeo console URL, without slashes.
# Example: mycompany  ->  https://api.asgardeo.io/t/mycompany
ASGARDEO_ORGANIZATION=

# Optional full base URL. Overrides ASGARDEO_ORGANIZATION when set.
ASGARDEO_BASE_URL=

ASGARDEO_REDIRECT_URI=http://localhost:5173/api/auth/callback
ASGARDEO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
FRONTEND_URL=http://localhost:5173

# Comma-separated emails that are created as active administrators on first Asgardeo login.
ADMIN_EMAILS=admin@demo.local

# Used to sign this demo's own session JWT. Replace this before sharing the project.
SESSION_SECRET=replace-with-a-long-random-string
SESSION_MINUTES=15

# Dummy password used only by mock mode. Delete the SQLite file after changing it.
DEMO_PASSWORD=DemoPass123!

# Empty uses backend/demo.db
DATABASE_PATH=
COOKIE_SECURE=false
